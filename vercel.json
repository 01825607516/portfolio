{
  "version": 2,
  "framework": null,
  "buildCommand": "composer install --no-dev && npm install && npm run build",
  "installCommand": "composer install --no-dev && npm install",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
